params {
    // set default values. These can be overwritten with a -params-file YAML file.
    consensus_min_qual_score = 0
    consensus_threshold = 0
    consensus_min_depth = 10
    consensus_coverage_cutoff = 0.75
    consensus_min_baseQ = 30
    consensus_min_mapQ = 20
    variant_min_baseQ = 30
    variant_min_mapQ = 20
    variant_freq_threshold = 0.01
    variant_min_depth = 10
    variant_minQ = 30
    tiled_amplicons=true
    remove_unclipped_reads=true
    skip_qc=false
    interleaved = false
    sequencing_technique = "amplicon"
    primer_csv = "${projectDir}/primers.csv"
    trimmomatic_jarfile = "/usr/local/bin/trimmomatic.jar"
}

process {
    maxRetries = 3
}

profiles {
    local {
        process.executor = 'local'
    }

    test {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            primer_bed = "${projectDir}/data/primers/primer.5.3.2.bed"
            primer_fasta = "${projectDir}/data/primers/v5.3.2_400_primers.fa"
            primer_pairs = "${projectDir}/data/primers/v5.3.2_400_primer_pairs.tsv"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            tiled_amplicons = true
            output_dir = "${projectDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.15
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
        }
        docker{
            enabled = true
        }
        process{
            container = 'quay.io/mccronelab/snper:latest'
        }
    }

    docker {
        docker.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }
    apptainer{
        apptainer.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }

    test_apptainer {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            primer_bed = "${projectDir}/data/primers/primer.5.3.2.bed"
            primer_fasta = "${projectDir}/data/primers/v5.3.2_400_primers.fa"
            primer_pairs = "${projectDir}/data/primers/v5.3.2_400_primer_pairs.tsv"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            tiled_amplicons = true
            output_dir = "${projectDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.15
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
            tiled_amplicons = true
        }
        apptainer{
            enabled = true
        }
        process{
            container = 'quay.io/mccronelab/snper:latest'
            maxRetries = 3
        }
    }

    rhino {
        process.executor = 'slurm'
        process.scratch = true
        report.overwrite = true
        executor.queueSize = 500

        apptainer.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }

    rhino_test {

        params {

            reference_fasta = './data/reference/NC_045512.fa'
            reference_gff = './data/reference/protein_annotations.gff3'
            primer_bed = './data/primers/SARS-CoV-2_V4.1_primers_alt_overlap_sites.bed'
            primer_fasta = './data/primers/v5.3.2_400_primers.fa'
            primer_pairs = './data/primers/v5.3.2_400_primer_pairs.tsv'
            sample_sheet = './testSampleSheet.csv'
            output_dir = './test-out'
            tiled_amplicons = true
        }

        process.executor = 'slurm'

        process.scratch = true

        report.overwrite = true
        apptainer.enabled = true
        executor.queueSize = 200
        process.container = 'quay.io/mccronelab/snper:latest'
    }
}