params {
    // set default values. These can be overwritten with a -params-file YAML file.
    consensus_min_qual_score = 0
    consensus_threshold = 0
    consensus_min_depth = 10
    consensus_coverage_cutoff = 0.75
    consensus_min_baseQ = 30
    consensus_min_mapQ = 20
    variant_min_baseQ = 30
    variant_min_mapQ = 20
    variant_freq_threshold = 0.01
    variant_min_depth = 10
    variant_minQ = 30
    tiled_amplicons=true
    remove_unclipped_reads=true
    skip_qc=false
    interleaved = false
    read_deduplication = "amplicon"
    primer_csv = "${projectDir}/primers.csv"
    trimmomatic_jarfile = "/usr/local/bin/trimmomatic.jar"
}

process {
    maxRetries = 3
}

profiles {
    local {
        process.executor = 'local'
    }

    test {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            tiled_amplicons = true
            output_dir = "${projectDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.05
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
        }
        docker{
            enabled = true
        }
        process{
            container = 'quay.io/mccronelab/snper:latest'
        }
    }

    docker {
        docker.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }
    apptainer{
        apptainer.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }

    test_apptainer {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            tiled_amplicons = true
            output_dir = "${projectDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.05
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
            tiled_amplicons = true
        }
        apptainer{
            enabled = true
        }
        process{
            container = 'quay.io/mccronelab/snper:latest'
            maxRetries = 3
        }
    }

    rhino {
        process.executor = 'slurm'
        process.scratch = true
        report.overwrite = true
        executor.queueSize = 500

        apptainer.enabled = true
        process.container = 'quay.io/mccronelab/snper:latest'
    }

    rhino_test {

        params {

            reference_fasta = './data/reference/MN908947.fasta'
            reference_gff = './data/reference/SARS_CoV_2.gff3'
            sample_sheet = './testSampleSheet_opt.csv'
            output_dir = './test-out'
            tiled_amplicons = true
            primer_id_default = 'ARTIC_v5'
        }

        process.executor = 'slurm'

        process.scratch = true

        report.overwrite = true
        apptainer.enabled = true
        executor.queueSize = 200
        process.container = 'quay.io/mccronelab/snper:latest'
    }
}