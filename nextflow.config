// Validates params against nextflow_schema.json. Strict mode alone does not catch a
// misspelled key in a -params-file: it lands in the params map, nothing reads it, and
// the run proceeds with the default silently in force.
plugins {
    id 'nf-schema@2.8.0'
}

validation {
    logging {
        // Default is a warning, which scrolls past in a long log — the run then proceeds
        // with the default silently in force, which is the failure this is meant to catch.
        unrecognisedParams = 'error'
    }

    help {
        enabled = true
        command = 'nextflow run mccronelab/SNPer -params-file params.yaml'
    }
}

params {
    // set default values. These can be overwritten with a -params-file YAML file.
    // Null rather than absent: the publishDir directives interpolate it at parse time,
    // before validation, and warn on an undefined param. The schema still requires it.
    output_dir = null
    // The image every process runs. A param because the profiles set it through a
    // `withName` selector, which outranks -process.container and leaves that flag inert.
    container_image = 'quay.io/mccronelab/snper:latest'
    consensus_min_qual_score = 0
    consensus_threshold = 0
    consensus_min_depth = 10
    consensus_coverage_cutoff = 0.75
    consensus_min_baseQ = 30
    consensus_min_mapQ = 20
    variant_min_baseQ = 30
    variant_min_mapQ = 20
    variant_freq_threshold = 0.01
    variant_min_depth = 10
    variant_minQ = 30
    remove_unclipped_reads=true
    skip_qc=false
    interleaved = false
    read_deduplication = "positional"
    primer_csv = "${projectDir}/primers.csv"
    fastp_min_length = 36
    min_mapped_reads = 1000
    skip_fastqc = false
}

manifest {
    name = 'mccronelab/SNPer'
    homePage = 'https://github.com/mccronelab/SNPer'
    description = 'Viral in-host (iSNV) variant-calling workflow'
    mainScript = 'main.nf'
    // Without this Nextflow falls back to 'master' when resolving the repository,
    // but this repo's default branch is 'main' — so `nextflow run <github-url>`
    // fails at pull time, before params or containers are ever considered.
    defaultBranch = 'main'
    version = '2.4.0-Beta'
    nextflowVersion = '>=26.04.6'
}

process {
    maxRetries = 3
}

// Bind the paths a task actually needs (CWD, $HOME) into the container. Apptainer's
// own defaults cover these only sometimes — notably not when work dirs live on a
// shared cluster filesystem — so make it explicit rather than leaving it to chance.
apptainer.autoMounts = true

// Each profile declares its container as a `withName: '.*'` selector rather than a bare
// process.container: nf-schema reads workflow.container as a Map, and Nextflow only builds
// one when a selector sets the container — a global assignment arrives as a String.
// The selector reads params.container_image, since a selector outranks -process.container.
profiles {
    local {
        process.executor = 'local'
    }

    test {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            output_dir = "${launchDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.05
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
        }
        docker{
            enabled = true
        }
        process{
            withName: '.*' { container = params.container_image }
        }
    }

    docker {
        docker.enabled = true
        process {
            withName: '.*' { container = params.container_image }
        }
    }
    apptainer{
        apptainer.enabled = true
        process {
            withName: '.*' { container = params.container_image }
        }
    }

    test_apptainer {
        params{
            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            output_dir = "${launchDir}/test-out/"
            consensus_min_qual_score = 0
            consensus_threshold = 0
            consensus_min_depth = 10
            consensus_coverage_cutoff = 0.05
            consensus_min_baseQ = 30
            consensus_min_mapQ = 20
            variant_minQ = 30
            variant_min_baseQ = 30
            variant_min_mapQ = 20
            variant_freq_threshold = 0.005
            variant_min_depth = 1
            primer_id_default = "ARTIC_v5"
        }
        apptainer{
            enabled = true
        }
        process{
            withName: '.*' { container = params.container_image }
            maxRetries = 3
        }
    }

    rhino {
        process.executor = 'slurm'
        process.scratch = true
        report.overwrite = true
        executor.queueSize = 500

        apptainer.enabled = true
        process {
            withName: '.*' { container = params.container_image }
        }
    }

    rhino_test {

        params {

            reference_fasta = "${projectDir}/data/reference/MN908947.fasta"
            reference_gff = "${projectDir}/data/reference/SARS_CoV_2.gff3"
            sample_sheet = "${projectDir}/testSampleSheet_opt.csv"
            output_dir = "${launchDir}/test-out"
            primer_id_default = 'ARTIC_v5'
        }

        process.executor = 'slurm'

        process.scratch = true

        report.overwrite = true
        apptainer.enabled = true
        executor.queueSize = 200
        process {
            withName: '.*' { container = params.container_image }
        }
    }
}