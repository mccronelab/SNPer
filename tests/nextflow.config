/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/
// The container is a `withName: '.*'` selector, not a global process.container, for the
// reason given in the root nextflow.config: nf-schema reads workflow.container as a Map,
// and Nextflow only builds one when a selector sets the container.
profiles {
    ci_test {
        docker.enabled = true
        process {
            withName: '.*' { container = 'snper-ci:latest' }
        }
    }
}